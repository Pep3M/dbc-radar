# Solami API key (https://solami.dev). Enables the gRPC stream, Blur and the Data API.
# Leave it empty to fall back to the public Solana RPC (lossy: it gets rate limited).
SOLAMI_API_KEY=

# Transaction source: grpc | rpc. Defaults to grpc when SOLAMI_API_KEY is set, rpc otherwise.
# SOURCE=grpc

# Solami endpoints
# SOLAMI_GRPC_URL=https://grpc.solami.dev
# SOLAMI_DATA_API_URL=https://api.solami.dev
# SOLAMI_BLUR_WS_URL=wss://ws.solami.dev/data/subscribe
# SOLAMI_RPC_URL=https://rpc.solami.dev/solana

# gRPC commitment: processed (fastest, default) | confirmed (waits for votes, ~0.5-1 s later)
# GRPC_COMMITMENT=processed

# RPC fallback (only used when SOURCE=rpc)
# RPC_URL=https://api.mainnet-beta.solana.com
# RPC_WS_URL=
# RPC_MAX_CONCURRENCY=4

# Indexer HTTP API port and SQLite path (relative to apps/indexer)
# PORT=4000
# DB_PATH=../../data/radar.sqlite

# Public base URL used in alert links
# PUBLIC_URL=https://pep3marquez.com/dbc-radar

# Alerts (all optional). Rules for the site-wide feed, webhook and fixed Telegram chat:
# ALERT_CURVE_THRESHOLD=0.8
# ALERT_GRADUATIONS=1
# ALERT_SKIP_FAST_GRADUATIONS_MS=60000
# ALERT_FLAGS=creator_sold
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_SECRET=

# Telegram subscriber bot (@BotFather token). Visitors /start it and pick their own settings.
# Only ONE process may poll a bot: set TELEGRAM_POLLING=0 on every other instance (e.g. local
# dev while production runs the bot). TELEGRAM_CHAT_ID adds a fixed chat/channel that gets
# every site-wide alert.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_POLLING=1
# TELEGRAM_CHAT_ID=
